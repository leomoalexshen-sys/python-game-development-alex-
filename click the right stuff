import pgzrun
import random

WIDTH =1500
HEIGHT = 750

num_of_animals = [ ]

animations = []

gameover = False

gamecomplete = False

chinchilla = Actor("chinchilla")


cat = Actor("cat")


dog = Actor("dog")


guinea_pig = Actor("guinea_pig")


horse = Actor("horse")


pigs = Actor("pigs")


button = Actor("button")
button.pos = 100, 300



pets = ["cat", "dog", "guinea_pig", "horse", "pigs"]

level = 1
total_levels = 5
game_start = False 

def start_level():
    global num_of_animals, animations
    num_of_animals = []
    animations = []
    num_of_animals = make_animals(level)

def on_mouse_down(pos):
    global button, pets, animations, mouse_pos, game_start
    if not game_start:
        if button.collidepoint(pos):
            game_start = True
            start_level()
    for i in num_of_animals:
        if i.collidepoint(pos):
            if "chinchilla" in i.image:
                game_complete()
            else:
                game_over()

def game_over():
    global gameover
    gameover = True

def game_complete():
    global gamecomplete, num_of_animals, level, animations
    stop_animations(animations)
    if level == total_levels:
        gamecomplete = True
    else:
        level+=1
        num_of_animals = []
        animations = []

def stop_animations(animations_to_stop):
    for d in animations_to_stop:
        if d.running:
            d.stop()
    

def rolling_down(items_to_roll):
    global animations, pets, WIDTH, HEIGHT
    for i in items_to_roll:
        animation = animate(i, duration = 2, y = HEIGHT+100, on_finished = game_over)
        animations.append(animation)

thecolor = random.randint(5, 255), random.randint(5, 255), random.randint(5, 255)

def draw():
    global button, thecolor
    screen.blit("background", (0, 0))
    screen.draw.text("CLICK THE CHINCHILLA!!!!!!!!!!!!!!!!", (75, 75), fontsize=100, color="white")
    button.draw()
    if gameover:
        screen.fill("black")
        screen.draw.text("GAME OVER", (WIDTH/2, HEIGHT/2), fontsize=100, color="red")
    elif gamecomplete:
        screen.fill(thecolor)
        screen.draw.text("YOU WIN", (WIDTH/2, HEIGHT/2), fontsize=100, color="black")
    else:
        for a in num_of_animals:
            a.draw()

def update():
    global num_of_animals
    if len(num_of_animals) == 0 and game_start:
        if not gameover and not gamecomplete:
            start_level()

def make_animals(extra):
    pets_to_create = select(extra)
    new_pets = create_animals(pets_to_create)
    lay_out(new_pets)
    rolling_down(new_pets)
    return new_pets

def select(extra):
    pets_to_create = ["chinchilla"]
    for b in range(extra):
        pets_to_create.append(random.choice(pets))
    return pets_to_create

def create_animals(pets_to_make):
    new_pets = []
    for c in pets_to_make:
        new_pet = Actor(c)
        new_pets.append(new_pet)
    return new_pets

def lay_out(animals_to_lay):
    gaps = len(animals_to_lay) + 1
    gap_size = WIDTH / gaps
    random.shuffle(animals_to_lay)
    for e, f in enumerate(animals_to_lay):
        new_x = (e + 1) * gap_size 
        f.x = new_x

pgzrun.go()
