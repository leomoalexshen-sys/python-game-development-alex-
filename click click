import pgzrun
import random

WIDTH =1500
HEIGHT = 750

animations = []



chinchilla = Actor("chinchilla")


cat = Actor("cat")


dog = Actor("dog")


guinea_pig = Actor("guinea_pig")


horse = Actor("horse")


pigs = Actor("pigs")


button = Actor("button")
button.pos = 100, 300


pets = [cat, dog, guinea_pig, horse, pigs]

def randomizer (animals):
    global pets
    the_choice = random.choice(pets)

def on_mouse_down(pos):
    global button, pets, animations, mouse_pos
    mouse_pos = pos
    if button.collidepoint(pos):
        randomizer(pets)
        rolling_down(pets)
        button.pos = 9999, 9999

def rolling_down(items_to_roll):
    global animations, pets, WIDTH, HEIGHT
    for i in items_to_roll:
        animation = animate(i, duration = 2, y = HEIGHT)
        animations.append(animation)

def draw():
    global button
    screen.blit("background", (0, 0))
    screen.draw.text("CLICK THE CHINCHILLA!!!!!!!!!!!!!!!!", (75, 75), fontsize=100, color="white")
    button.draw()
    for a in pets:
        a.draw()

pgzrun.go()
